<h2>Acá van los servicios</h2>

<ul class="service-list" data-services-list>
    {{#if services}}
        {{#each services}}
            <li class="service-card service-item" data-service-id="{{this._id}}">
                <p><strong>Nombre:</strong> {{this.name}}</p>
                <p><strong>Precio:</strong> ${{this.price}}</p>
            </li>
        {{/each}}
    {{else}}
        <li class="empty-state">No hay servicios disponibles. Importá los servicios iniciales o creá uno desde la API.</li>
    {{/if}}
</ul>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/services.js"></script>
